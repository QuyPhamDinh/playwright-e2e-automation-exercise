{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript end-to-end framework for Automation Exercise with API-backed UI fixtures.",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:integrated": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:smoke": "playwright test --grep @smoke",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
